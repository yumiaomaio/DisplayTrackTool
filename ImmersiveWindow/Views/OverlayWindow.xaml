<!-- File: Views/OverlayWindow.xaml -->
<Window x:Class="ImmersiveWindow.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Black"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="False">
    <Grid>
        <!-- 背景图片将填满整个窗口 -->
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" />
    </Grid>
</Window>