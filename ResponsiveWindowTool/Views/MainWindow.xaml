<!-- File: Views/MainWindow.xaml -->
<Window x:Class="ResponsiveWindowTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Responsive Window Tool" Height="450" Width="600"
        xmlns:helpers="clr-namespace:ResponsiveWindowTool.Helpers"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <helpers:InvertBoolConverter x:Key="InvertBoolConverter"/> <!-- 将资源定义移到这里 -->
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Controls -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Target Process Name (without .exe):" FontWeight="Bold"/>
            <TextBox Text="{Binding TargetProcessName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBoolConverter}}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Start" Command="{Binding StartCommand}" Width="100" Height="30" Margin="5" Background="LightGreen"/>
                <Button Content="Stop" Command="{Binding StopCommand}" Width="100" Height="30" Margin="5" Background="Salmon"/>
            </StackPanel>
        </StackPanel>
        
        <!-- Logs -->
        <GroupBox Grid.Row="1" Header="Logs" Margin="0,20,0,0">
            <ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="11"/>
        </GroupBox>
    </Grid>
</Window>