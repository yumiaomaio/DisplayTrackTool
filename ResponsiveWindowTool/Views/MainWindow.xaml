<!-- File: Views/MainWindow.xaml -->
<Window x:Class="ResponsiveWindowTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Responsive Window Tool" Height="450" Width="600"
        xmlns:helpers="clr-namespace:ResponsiveWindowTool.Helpers"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <helpers:InvertBoolConverter x:Key="InvertBoolConverter"/>
    </Window.Resources>
    <Grid Margin="15">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Controls -->
    <StackPanel Grid.Row="0">
        <!-- Process Name -->
        <TextBlock Text="Target Process Name (without .exe):" FontWeight="Bold"/>
        <TextBox Text="{Binding TargetProcessName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBoolConverter}}"/>

        <!-- Aspect Ratio -->
        <TextBlock Text="Portrait Aspect Ratio (e.g., 9/16):" FontWeight="Bold"/>
        <TextBox Text="{Binding PortraitAspectRatio, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBoolConverter}}"/>
        
        <!-- NEW: Display Settings -->
        <TextBlock Text="Target Display Settings:" FontWeight="Bold" Margin="0,10,0,0"/>
        <Grid Margin="0,5,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding TargetResolutionWidth, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBoolConverter}}"/>
            <TextBlock Grid.Column="1" Text=" x " VerticalAlignment="Center"/>
            <TextBox Grid.Column="2" Text="{Binding TargetResolutionHeight, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBoolConverter}}"/>
            <TextBlock Grid.Column="3" Text=" @ " VerticalAlignment="Center"/>
            <TextBox Grid.Column="4" Text="{Binding TargetDpi, UpdateSourceTrigger=PropertyChanged}" MinWidth="50" IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBoolConverter}}">
                <TextBox.ToolTip>
                    <ToolTip>
                        <TextBlock Text="DPI (%)"/>
                    </ToolTip>
                </TextBox.ToolTip>
            </TextBox>
        </Grid>

        <!-- NEW: Confirmation CheckBox -->
        <CheckBox Content="Require confirmation on exit" 
                  IsChecked="{Binding RequireConfirmationOnExit, Mode=TwoWay}" 
                  Margin="0,5,0,0" 
                  IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBoolConverter}}"/>

    </StackPanel>
        
        <!-- Background Image Selection -->
        <StackPanel Grid.Row="1" Margin="0,15,0,0">
            <TextBlock Text="Background Image:" FontWeight="Bold"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding CurrentImageFileName, FallbackValue='None (Solid Black)'}" 
                           VerticalAlignment="Center" FontStyle="Italic"
                           TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Content="Select Image..." 
                        Command="{Binding SelectImageCommand}" 
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBoolConverter}}"
                        Padding="8,4"/>
                <Button Grid.Column="2" Content="Clear" Command="{Binding ClearImageCommand}" Margin="5,0,0,0" Padding="8,4"/>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button Content="Start" Command="{Binding StartCommand}" Width="100" Height="30" Background="LightGreen"/>
                <Button Content="Stop" Command="{Binding StopCommand}" Width="100" Height="30" Background="Salmon"/>
            </StackPanel>
        </StackPanel>
        
        <!-- Logs -->
        <GroupBox Grid.Row="2" Header="Logs" Margin="0,20,0,0">
            <ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="11"/>
        </GroupBox>
    </Grid>
</Window>