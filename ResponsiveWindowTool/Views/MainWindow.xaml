<!-- File: Views/MainWindow.xaml (Beautified) -->
<Window x:Class="ResponsiveWindowTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:ResponsiveWindowTool.Helpers"
        Title="Responsive Window Tool" Height="550" Width="600" MinWidth="500" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#FFEFEFEF">
    
    <Window.Resources>
        <helpers:InvertBoolConverter x:Key="InvertBoolConverter"/>

        <!-- Simple global style for TextBoxes -->
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="BorderBrush" Value="#FFABADB3"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Simple global style for Buttons -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderBrush" Value="#FFABADB3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFE0E0E0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFEEEEEE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style for GroupBox Headers -->
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="14" Foreground="#FF333333"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Settings Area -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Target Application Group -->
                <GroupBox Header="Target Application">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Process Name:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Text="{Binding TargetProcessName, UpdateSourceTrigger=PropertyChanged}" 
                                 IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBoolConverter}}"
                                 ToolTip="The name of the process without .exe (e.g., notepad)"/>
                    </Grid>
                </GroupBox>

                <!-- Display & Layout Group -->
                <GroupBox Header="Display and Layout">
                    <StackPanel>
                        <!-- Aspect Ratio -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Portrait Aspect Ratio:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding PortraitAspectRatio, UpdateSourceTrigger=PropertyChanged}" 
                                     IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBoolConverter}}"
                                     ToolTip="The aspect ratio for portrait mode (e.g., 9/16 or 0.5625)"/>
                        </Grid>
                        
                        <!-- Display Settings Override -->
                        <CheckBox IsChecked="{Binding EnableDisplaySettingsOverride}"
                                  Content="Override Display Settings (Resolution and DPI)" FontWeight="SemiBold"
                                  IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBoolConverter}}"/>
                        <Border Padding="15,10" Margin="0,5,0,15" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="3"
                                IsEnabled="{Binding EnableDisplaySettingsOverride}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding TargetResolutionWidth, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBoolConverter}}"/>
                                <TextBlock Grid.Column="1" Text=" x " VerticalAlignment="Center" Margin="5,0"/>
                                <TextBox Grid.Column="2" Text="{Binding TargetResolutionHeight, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBoolConverter}}"/>
                                <TextBlock Grid.Column="3" Text=" @ " VerticalAlignment="Center" Margin="5,0"/>
                                <TextBox Grid.Column="4" Text="{Binding TargetDpi, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBoolConverter}}" ToolTip="DPI Scale (%)"/>
                            </Grid>
                        </Border>

                        <!-- Background Overlay -->
                        <CheckBox IsChecked="{Binding EnableBackgroundOverlay}"
                                  Content="Enable Background Overlay" FontWeight="SemiBold"
                                  IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBoolConverter}}"/>
                        <Border Padding="10" Margin="0,5,0,0" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="3"
                                IsEnabled="{Binding EnableBackgroundOverlay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding CurrentImageFileName, FallbackValue='Using solid color'}" 
                                           VerticalAlignment="Center" FontStyle="Italic" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Content="Select Image..." Command="{Binding SelectImageCommand}" Margin="10,0,0,0"
                                        IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBoolConverter}}"/>
                                <Button Grid.Column="2" Content="Clear" Command="{Binding ClearImageCommand}" Margin="5,0,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </GroupBox>

                 <!-- Options Group -->
                <GroupBox Header="Options">
                     <CheckBox Content="Require confirmation on exit" 
                               IsChecked="{Binding RequireConfirmationOnExit, Mode=TwoWay}" 
                               IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBoolConverter}}"/>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Logs Area -->
        <GroupBox Grid.Row="1" Header="Logs" Margin="0,10,0,0">
            <ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="12"
                     BorderThickness="0" Background="White"/>
        </GroupBox>

        <!-- Action Buttons Area -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Start" Command="{Binding StartCommand}" Width="120" Height="35" FontWeight="Bold" Margin="0,0,10,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Background" Value="#FFD9FEDA"/>
                        <Setter Property="BorderBrush" Value="#FF8BC34A"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE9FFE8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Stop" Command="{Binding StopCommand}" Width="120" Height="35" FontWeight="Bold">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Background" Value="#FFFFE0E0"/>
                        <Setter Property="BorderBrush" Value="#FFFF7A7A"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFFFEBEB"/>
                            </Trigger>
                             <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>